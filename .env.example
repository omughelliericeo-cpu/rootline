# Copy this file to .env and fill in the values. Empty values mean "not configured";
# the app still runs and /api/health reports the service as not_configured.

# Public base URL used to build QR code links and email links.
APP_URL=http://localhost:3000

# Postgres.
# DATABASE_URL is what the running app uses: the restricted "rootline_app" role,
# so row-level security applies (see README "Database roles").
# DIRECT_URL is used by Prisma migrations: the database owner, no pooler.
DATABASE_URL=postgresql://rootline_app:rootline_app_dev@localhost:5432/rootline
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/rootline

# Supabase (auth + file storage). From Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend (recall emails). EMAIL_FROM must be on a domain verified in Resend,
# e.g. "Cedar & Tide <alerts@cedarandtide.ca>". Without one, Resend's test sender
# only delivers to your own Resend account email.
RESEND_API_KEY=
EMAIL_FROM=
# "resend" (real email) or "log" (write emails to the logs only, for trying it out).
EMAIL_PROVIDER=resend

# Address lookup for "Find on map". Empty = OpenStreetMap's public Nominatim service.
GEOCODER_URL=

# Sentry (error tracking). Leave empty to disable.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# debug | info | warn | error | silent
LOG_LEVEL=info

# Plans and billing (optional). Without these, plans still apply but can't be bought online.
# Test keys start with sk_test_. Run `npm run stripe:setup` once to create the prices.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
# Shown on /pricing and Plan & billing for Enterprise enquiries.
SALES_EMAIL=
